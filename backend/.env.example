# Bugzzy backend environment variables.
#
# Copy this file to ".env" and fill in real values:
#     cp .env.example .env
#
# ".env" is git-ignored (it holds secrets). This example file is safe to
# commit and only contains placeholders, never real values.

# ---------------------------------------------------------------------------
# Required: GitHub App credentials
# ---------------------------------------------------------------------------

# The numeric App ID from the GitHub App settings page.
GITHUB_APP_ID=your-app-id-here

# The App's client id (starts with "Iv" for newer GitHub Apps).
GITHUB_CLIENT_ID=your-client-id-here

# The App's client secret. Treat this like a password.
GITHUB_CLIENT_SECRET=your-client-secret-here

# Path to the App's private key (.pem). Relative paths are resolved from the
# "backend" folder.
GITHUB_PRIVATE_KEY_PATH=./secrets/your-private-key.pem

# The secret you set for the App's webhooks.
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# ---------------------------------------------------------------------------
# Optional: sensible defaults are shown below. Remove the "#" to override.
# ---------------------------------------------------------------------------

# Where GitHub sends users back after they authorize the App. Must match the
# callback URL registered on the App.
# GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# The website users are sent back to after a successful login.
# FRONTEND_URL=http://localhost:5173

# "development" or "production". Cookies get the Secure flag only in
# production.
# APP_ENV=development

# Name of the session cookie.
# SESSION_COOKIE_NAME=bugzzy_session

# Absolute maximum session lifetime, in seconds (default 7 days).
# SESSION_MAX_AGE_SECONDS=604800

# How long a session may sit idle before it expires, in seconds (default 24h).
# SESSION_IDLE_TIMEOUT_SECONDS=86400

# ---------------------------------------------------------------------------
# Database: Neon PostgreSQL
# ---------------------------------------------------------------------------

# Main database connection string (Neon PostgreSQL). Required in production;
# when it is missing in development the app uses in-memory stores.
DATABASE_URL=your_connection_string_here

# Optional: a separate database for the database tests. Use a separate Neon
# branch or database, never the main one. Leave it unset to skip those tests.
TEST_DATABASE_URL=your_test_connection_string_here

